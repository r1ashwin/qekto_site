{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/brands", "destination": "/", "permanent": true },
    { "source": "/publishers", "destination": "/", "permanent": true },
    { "source": "/pricing", "destination": "/pilot", "permanent": true },
    { "source": "/contact", "destination": "/pilot", "permanent": true },
    { "source": "/board", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; script-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ]
}
